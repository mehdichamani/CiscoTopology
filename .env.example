# Simban (Cisco Switch Management) Configuration
# پورت پیش‌فرض داشبورد سیم‌بان
PORT=23458

# Cisco Switch Management Credentials
SWITCH_TELNET_PORT=23
SWITCH_DEVICE_TYPE=cisco_ios_telnet
SWITCH_USERNAME=admin
SWITCH_SECRET=
SWITCH_TIMEOUT=10

# Comma-separated list of IPs to exclude from scans and collection (e.g. Wireless Radios)
EXCLUDED_IPS=192.168.30.50,192.168.30.51,192.168.30.52
