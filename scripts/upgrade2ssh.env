# ==============================================================================
# پیکربندی اتصال پایه Telnet جهت ارتقا به SSH
# ==============================================================================
# آدرس IP فعلی سوئیچ برای اتصال اولیه از طریق Telnet
TELNET_HOST=192.168.30.13
TELNET_PORT=23
# نام‌کاربری تلنت (در صورتی که سوییچ فقط رمز می‌خواهد خالی بگذارید)
TELNET_USERNAME=
# رمز عبور ورود تلنت (Login Password)
TELNET_PASSWORD=@Aa3603912!
# رمز عبور حالت Enable (در صورتی که سوئیچ مستقیماً روی سطح 15 نباشد)
TELNET_ENABLE_PASSWORD=@Aa3603912!
# زمان انتظار برای پاسخ سوییچ بر حسب ثانیه
TELNET_TIMEOUT=15

# ==============================================================================
# مشخصات کاربری و دسترسی جدید در سوئیچ (جهت SSH و ادمین)
# ==============================================================================
SWITCH_USERNAME=admin
SWITCH_SECRET=@Aa3603912!
SWITCH_PRIVILEGE=15

# رمزی که مایلید از این پس خطوط VTY برای تلنت استفاده کنند (گام ۴.۵ مستند)
NEW_TELNET_PASSWORD=@Aa3603912!

# ==============================================================================
# تنظیمات هویت سوئیچ
# ==============================================================================
SWITCH_HOSTNAME=
SWITCH_DOMAIN=uromsachi.local

# ==============================================================================
# مسیر کلید عمومی SSH جهت استخراج MD5 و تزریق به سوئیچ
# ==============================================================================
PUBKEY_PATH=C:/Users/Mehdi/.ssh/id_rsa_cisco.pub

# ==============================================================================
# تولید کلید هاست RSA روی سوئیچ (true / false)
# ==============================================================================
GENERATE_RSA_HOSTKEY=true
RSA_KEY_MODULUS=2048
